# DriftSense .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets & Local Configs
.env
.env.*
!.env.example
*.pem
*.key

# Data & Large Artifacts (Colab / Runtime)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/predictions/*
!data/predictions/.gitkeep
data/events/*
!data/events/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
metrics/*
!metrics/.gitkeep
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep
artifacts/*
!artifacts/.gitkeep
runs/*
!runs/.gitkeep

# Generated Notebooks (built via scripts/build_notebooks.py)
notebooks/generated/*
!notebooks/generated/.gitkeep

# Frontend build & packages
frontend/node_modules/
frontend/dist/
