# ## 1. Setup & Environment Installation

# %%
import os
import sys
import subprocess
from pathlib import Path

# Pinned repository commit SHA or branch for reproducibility
PINNED_COMMIT_SHA = "v2-enterprise"
REPO_URL = "https://github.com/hswaym/DriftSense-Anamoly-Detection.git"

# Clone if running on fresh Colab runtime
if not os.path.exists("src/driftsense"):
    if os.path.exists("repo"):
        os.chdir("repo")
    else:
        print("Cloning repository in Google Colab...")
        subprocess.run(["git", "clone", REPO_URL, "repo"], check=True)
        os.chdir("repo")
    if PINNED_COMMIT_SHA != "main":
        subprocess.run(["git", "checkout", PINNED_COMMIT_SHA], check=True)

# Install driftsense package and dependencies
print("Installing driftsense in development mode...")
subprocess.run([sys.executable, "-m", "pip", "install", "-e", "."], check=True)
if os.path.exists("requirements-colab.txt"):
    subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements-colab.txt"], check=True)

# Ensure src directory is on sys.path for active Colab kernel
src_dir = os.path.abspath("src")
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

print(f"Environment setup complete. Added {src_dir} to sys.path.")

# %% [markdown]
# ## 2. Hardware Diagnostics

# %%
from driftsense.runtime.hardware import check_hardware

hw = check_hardware(requested_device="cpu")
print("=== Hardware Diagnostic Summary ===")
for k, v in hw.items():
    print(f"{k:20}: {v}")

# %% [markdown]
# ## 3. Storage Setup & Run Directory Initialization

# %%
import uuid
import datetime

RUN_ID = f"run_{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:6]}"
RUN_DIR = Path(f"runs/{RUN_ID}")
RUN_DIR.mkdir(parents=True, exist_ok=True)
print(f"Active Run Directory: {RUN_DIR.resolve()}")

# %% [markdown]
# ## 4. Dataset Acquisition & Integrity Check

# %%
from driftsense.data.acquire import acquire_dataset
from driftsense.runtime.config import load_config

CONFIG_PATH = "configs/data_focus.yaml"
cfg, config_sha256 = load_config(CONFIG_PATH)

dataset_cfg = cfg["dataset"]
acq_result = acquire_dataset(
    url=dataset_cfg["url"],
    destination=dataset_cfg["local_path"],
    expected_sha256=dataset_cfg["sha256"],
    overwrite=False,
)

print("Acquisition Status:")
for k, v in acq_result.items():
    print(f"  {k:15}: {v}")

# %% [markdown]
# ## 5. Dataset Validation & Quality Report Emission

# %%
from driftsense.data.validate import validate_dataset

QUALITY_REPORT_PATH = RUN_DIR / "data_quality_report.json"
val_report = validate_dataset(
    data_path=acq_result["path"],
    output_report_path=QUALITY_REPORT_PATH,
)

print(f"Validation Status: {val_report['status']}")
print(f"Total Rows:        {val_report['total_rows']}")
print(f"Total Columns:     {val_report['total_columns']}")
if val_report["issues"]:
    print("Flagged Issues / Warnings:")
    for issue in val_report["issues"][:10]:
        print(f"  - {issue}")

# Abort on critical validation failure
if val_report["status"] not in ("PASSED", "WARNINGS"):
    raise RuntimeError(f"Data validation failed: {val_report['issues']}")

# %% [markdown]
# ## 6. Manifest Generation & Checksum Export

# %%
import json
from driftsense.runtime.manifest import ManifestBuilder

builder = ManifestBuilder(
    run_id=RUN_ID,
    phase="PHASE_3",
    stage="acquire_validate",
    config_path=CONFIG_PATH,
    config_sha256=config_sha256,
    seed=cfg["runtime"]["seed"],
    dataset_ids=[dataset_cfg["id"]],
)

# Register acquired dataset and generated quality report
builder.register_dataset_file(acq_result["path"])
builder.add_artifact(QUALITY_REPORT_PATH)

MANIFEST_PATH = builder.save(RUN_DIR)
print(f"Manifest written to: {MANIFEST_PATH}")

# Verify manifest self-consistency
from driftsense.runtime.manifest import verify_manifest
is_valid, errors = verify_manifest(RUN_DIR)
if is_valid:
    print("Manifest verification: PASS (All artifact SHA256 checksums match)")
else:
    raise RuntimeError(f"Manifest verification failed: {errors}")
