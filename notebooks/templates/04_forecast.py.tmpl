# %% [markdown]
# ## 3. Storage Setup & Run Directory Initialization

# %%
import uuid
import datetime

RUN_ID = f"run_{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:6]}"
RUN_DIR = Path(f"runs/{RUN_ID}")
MODELS_DIR = RUN_DIR / "models"
MODELS_DIR.mkdir(parents=True, exist_ok=True)
print(f"Active Run Directory: {RUN_DIR.resolve()}")
print(f"Models Directory:     {MODELS_DIR.resolve()}")

# %% [markdown]
# ## 4. Configuration & Dataset Split Verification

# %%
import json
import pandas as pd
from driftsense.runtime.config import load_config
from driftsense.data.clean import clean_focus_data
from driftsense.data.aggregate import aggregate_to_canonical_grain
from driftsense.data.acquire import acquire_dataset
from driftsense.eval.splits import chronological_split
from driftsense.features.builder import FeaturePipeline

CONFIG_PATH = "configs/forecast_v2.yaml"
cfg, config_sha256 = load_config(CONFIG_PATH)

dataset_cfg = cfg.get("dataset", {})
models_cfg = cfg.get("models", {})
eval_cfg = cfg.get("evaluation", {})
conf_cfg = cfg.get("conformal", {})

train_path = Path(dataset_cfg.get("train_path", "data/splits/train_features.csv"))
val_path = Path(dataset_cfg.get("val_path", "data/splits/val_features.csv"))

if not train_path.is_file() or not val_path.is_file():
    print("Feature splits not detected locally. Regenerating from pipeline...")
    raw_path = Path("data/raw/focus_sample_10000.csv")
    if not raw_path.is_file():
        d_cfg, _ = load_config("configs/data_focus.yaml")
        acquire_dataset(
            url=d_cfg["dataset"]["url"],
            destination=str(raw_path),
            expected_sha256=d_cfg["dataset"]["sha256"],
            overwrite=False,
        )
    df_raw = pd.read_csv(raw_path, low_memory=False)
    df_clean, _ = clean_focus_data(df_raw)
    df_agg, _ = aggregate_to_canonical_grain(df_clean, grain="1h")
    
    train_df, val_df, test_df, _ = chronological_split(df_agg, time_col="ChargePeriodStart")
    pipeline = FeaturePipeline(mode="A")
    pipeline.fit(train_df)
    train_feats = pipeline.transform(train_df)
    val_feats = pipeline.transform(val_df)
    test_feats = pipeline.transform(test_df)
    
    train_path.parent.mkdir(parents=True, exist_ok=True)
    train_feats.to_csv(train_path, index=False)
    val_feats.to_csv(val_path, index=False)
    test_feats.to_csv(train_path.parent / "test_features.csv", index=False)
    print("Splits regenerated successfully.")

print(f"Loading training features:   {train_path}")
df_train = pd.read_csv(train_path, low_memory=False)

print(f"Loading validation features: {val_path}")
df_val = pd.read_csv(val_path, low_memory=False)

# Strict Holdout Quarantine Guard (Rule C7)
assert "test" not in str(val_path).lower(), "RULE C7 VIOLATION: Test split passed into validation evaluator!"
print(f"Train Partition: {len(df_train):,} rows ({df_train['ServiceName'].nunique()} services)")
print(f"Val Partition:   {len(df_val):,} rows ({df_val['ServiceName'].nunique()} services)")

target_col = dataset_cfg.get("target_col", "EffectiveCost")
time_col = dataset_cfg.get("time_col", "ChargePeriodStart")
service_col = dataset_cfg.get("service_col", "ServiceName")
primary_metric = eval_cfg.get("primary_metric", "wape")

y_train = df_train[target_col].to_numpy(dtype=float)
y_val = df_val[target_col].to_numpy(dtype=float)

# %% [markdown]
# ## 5. Model Suite Training & Checkpointing

# %%
from driftsense.forecast.baselines import SeasonalNaiveForecaster, MovingAverageForecaster
from driftsense.forecast.ets import ETSForecaster
from driftsense.forecast.sarima import SARIMAForecaster
from driftsense.forecast.boosted import BoostedTreeForecaster
from driftsense.forecast.quantile import QuantileForecaster
from driftsense.forecast.conformal import SplitConformalCalibrator
from driftsense.eval.forecast_metrics import compute_forecast_evaluation_suite

models = [
    SeasonalNaiveForecaster(
        name="seasonal_naive",
        seasonality=models_cfg.get("seasonal_naive", {}).get("seasonality", 24),
        config=models_cfg.get("seasonal_naive", {}),
    ),
    MovingAverageForecaster(
        name="moving_average",
        window=models_cfg.get("moving_average", {}).get("window", 24),
        config=models_cfg.get("moving_average", {}),
    ),
    ETSForecaster(
        name="ets",
        alpha=models_cfg.get("ets", {}).get("alpha", 0.20),
        beta=models_cfg.get("ets", {}).get("beta", 0.05),
        gamma=models_cfg.get("ets", {}).get("gamma", 0.10),
        seasonality=models_cfg.get("ets", {}).get("seasonality", 24),
        config=models_cfg.get("ets", {}),
    ),
    SARIMAForecaster(
        name="sarima",
        seasonal_order=tuple(models_cfg.get("sarima", {}).get("seasonal_order", (1, 0, 0, 24))),
        config=models_cfg.get("sarima", {}),
    ),
    BoostedTreeForecaster(
        name="boosted_tree",
        objective=models_cfg.get("boosted_tree", {}).get("objective", "reg:tweedie"),
        tweedie_variance_power=models_cfg.get("boosted_tree", {}).get("tweedie_variance_power", 1.5),
        n_estimators=models_cfg.get("boosted_tree", {}).get("n_estimators", 120),
        max_depth=models_cfg.get("boosted_tree", {}).get("max_depth", 4),
        learning_rate=models_cfg.get("boosted_tree", {}).get("learning_rate", 0.05),
        config=models_cfg.get("boosted_tree", {}),
    ),
    QuantileForecaster(
        name="quantile_tree",
        quantiles=tuple(models_cfg.get("quantile", {}).get("quantiles", [0.10, 0.50, 0.90])),
        n_estimators=models_cfg.get("quantile", {}).get("n_estimators", 80),
        max_depth=models_cfg.get("quantile", {}).get("max_depth", 4),
        config=models_cfg.get("quantile", {}),
    ),
]

saved_checkpoints = []
predictions_dict = {
    time_col: df_val[time_col],
    service_col: df_val[service_col],
    f"{target_col}_actual": y_val,
}
model_results = {}

print("=== Fitting Forecasters on D_train ===")
for i, model in enumerate(models, 1):
    print(f"\n[{i}/{len(models)}] Fitting {model.name}...")
    model.fit(
        df_train,
        target_col=target_col,
        time_col=time_col,
        service_col=service_col,
    )
    
    preds = model.predict(df_val)
    predictions_dict[f"{target_col}_pred_{model.name}"] = preds
    
    m = compute_forecast_evaluation_suite(y_true=y_val, y_pred=preds, y_train=y_train)
    model_results[model.name] = {
        "metrics": m,
        "metadata": model.get_metadata(),
    }
    
    chk_path = model.save(MODELS_DIR)
    saved_checkpoints.append(str(chk_path))
    print(f"    Checkpointed: {chk_path.name} (Config SHA: {model.config_hash[:12]}...)")

# Select champion based on primary metric (WAPE)
champion_name = min(
    model_results.keys(),
    key=lambda k: model_results[k]["metrics"].get(primary_metric, float("inf")),
)
champion_model = next(m for m in models if m.name == champion_name)

print("\n" + "=" * 90)
print(f"CHAMPION MODEL: '{champion_name}' (Lowest {primary_metric.upper()} on D_val)")
print("=" * 90)

# %% [markdown]
# ## 6. Split Conformal Calibration

# %%
calibrator = SplitConformalCalibrator(
    forecaster=champion_model,
    default_alpha=conf_cfg.get("default_alpha", 0.10),
)
calibrator.calibrate(
    df_val,
    target_col=target_col,
    alphas=tuple(conf_cfg.get("alphas", [0.05, 0.10, 0.20])),
)

y_pred_champ, lower_band, upper_band = calibrator.predict_interval(df_val, alpha=0.10)
predictions_dict[f"{target_col}_conformal_lower_90"] = lower_band
predictions_dict[f"{target_col}_conformal_upper_90"] = upper_band

conformal_metrics = compute_forecast_evaluation_suite(
    y_true=y_val,
    y_pred=y_pred_champ,
    y_train=y_train,
    lower=lower_band,
    upper=upper_band,
    alpha=0.10,
)
model_results[champion_name]["conformal_metrics"] = conformal_metrics

print(f"\nConformal Calibration Summary (alpha=0.10):")
print(f"  Nominal Coverage:   90.0%")
print(f"  Empirical Coverage: {conformal_metrics['coverage'] * 100:.2f}%")
print(f"  Mean Band Width:    ${conformal_metrics['interval_width']:.2f}")
print(f"  Winkler Score:      {conformal_metrics['winkler_score']:.2f}")

# Save validation predictions matrix
val_preds_df = pd.DataFrame(predictions_dict)
val_preds_path = RUN_DIR / "val_forecast_predictions_v2.csv"
val_preds_df.to_csv(val_preds_path, index=False)
print(f"\nSaved validation predictions to: {val_preds_path}")

# Save validation metrics JSON
metrics_payload = {
    "run_id": RUN_ID,
    "timestamp_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "primary_metric": primary_metric,
    "champion_model": champion_name,
    "holdout_touched": False,
    "models": model_results,
}
val_metrics_path = RUN_DIR / "val_forecast_metrics_v2.json"
with open(val_metrics_path, "w", encoding="utf-8") as f:
    json.dump(metrics_payload, f, indent=2)

# %% [markdown]
# ## 7. Comparative Forecast & Uncertainty Visualization

# %%
import matplotlib.pyplot as plt

top_services = (
    df_val.groupby(service_col)[target_col]
    .sum()
    .sort_values(ascending=False)
    .head(3)
    .index.tolist()
)

fig, axes = plt.subplots(len(top_services), 1, figsize=(14, 4 * len(top_services)), sharex=False)
if len(top_services) == 1:
    axes = [axes]

for ax, svc in zip(axes, top_services):
    mask = df_val[service_col] == svc
    svc_val = df_val[mask].sort_values(by=time_col)
    t = pd.to_datetime(svc_val[time_col], utc=True)
    actuals = svc_val[target_col]
    
    ax.plot(t, actuals, label="Actual Cost ($)", color="black", linewidth=2.0)
    
    # Plot champion forecast
    champ_preds = val_preds_df.loc[mask].sort_values(by=time_col)[f"{target_col}_pred_{champion_name}"]
    ax.plot(t, champ_preds, label=f"Champion: {champion_name}", color="crimson", linewidth=2.0)
    
    # Plot conformal prediction interval
    l_band = val_preds_df.loc[mask].sort_values(by=time_col)[f"{target_col}_conformal_lower_90"]
    u_band = val_preds_df.loc[mask].sort_values(by=time_col)[f"{target_col}_conformal_upper_90"]
    ax.fill_between(t, l_band, u_band, color="crimson", alpha=0.18, label="90% Conformal Band")
    
    ax.set_title(f"Validation Forecast & 90% Conformal Interval: {svc}", fontsize=12, fontweight="bold")
    ax.set_ylabel("Effective Cost ($)")
    ax.grid(True, alpha=0.3)
    ax.legend(loc="upper right", framealpha=0.9)

plt.tight_layout()
plot_path = RUN_DIR / "forecast_comparison_v2.png"
fig.savefig(plot_path, dpi=200, bbox_inches="tight")
plt.close(fig)
print(f"Saved forecast visualization plot to: {plot_path}")

# %% [markdown]
# ## 8. Run Manifest Compilation & Holdout Quarantine Audit

# %%
from driftsense.runtime.manifest import ManifestBuilder, verify_manifest
from driftsense.runtime.seed import set_seed

set_seed(cfg.get("runtime", {}).get("seed", 42))

builder = ManifestBuilder(
    run_id=RUN_ID,
    phase="PHASE_6",
    stage="forecasting",
    config_path=CONFIG_PATH,
    seed=cfg.get("runtime", {}).get("seed", 42),
)

builder.add_dataset(str(train_path))
builder.add_dataset(str(val_path))

for chk in saved_checkpoints:
    builder.add_artifact(chk)
builder.add_artifact(str(val_metrics_path))
builder.add_artifact(str(val_preds_path))
builder.add_artifact(str(plot_path))

manifest_path = builder.save(RUN_DIR)
print(f"\nManifest successfully emitted to: {manifest_path}")

# Verify Rule C7 holdout quarantine invariant
manifest_data = json.loads(manifest_path.read_text(encoding="utf-8"))
for art in manifest_data.get("artifacts", []):
    path_str = art.get("path", "").lower()
    assert "test_features" not in path_str, f"C7 LEAKAGE: Test split found in manifest artifacts: {path_str}"
    assert "test_pred" not in path_str, f"C7 LEAKAGE: Test predictions found in manifest artifacts: {path_str}"

print("PASS: Rule C7 Holdout Quarantine Invariant Verified (Zero test artifacts in manifest).")

is_valid, errors = verify_manifest(RUN_DIR, require_datasets=True)
if is_valid:
    print("PASS: Run manifest verification succeeded (All SHA256 checksums verified).")
else:
    print(f"FAIL: Manifest verification failed: {errors}")
    sys.exit(1)
