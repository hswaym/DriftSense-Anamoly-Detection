    if os.path.exists("repo"):
        os.chdir("repo")
    else:
        print("Cloning repository in Google Colab...")
        subprocess.run(["git", "clone", REPO_URL, "repo"], check=True)
        os.chdir("repo")
    if PINNED_COMMIT_SHA != "main":
        subprocess.run(["git", "checkout", PINNED_COMMIT_SHA], check=True)

print("Installing driftsense in development mode...")
subprocess.run([sys.executable, "-m", "pip", "install", "-e", "."], check=True)
if os.path.exists("requirements-colab.txt"):
    subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements-colab.txt"], check=True)

# Ensure src directory is on sys.path for active Colab kernel
