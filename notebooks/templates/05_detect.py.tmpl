# %% [markdown]
# ## 3. Storage Setup & Run Directory Initialization

# %%
import uuid
import datetime

RUN_ID = f"run_{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:6]}"
RUN_DIR = Path(f"runs/{RUN_ID}")
MODELS_DIR = RUN_DIR / "models"
MODELS_DIR.mkdir(parents=True, exist_ok=True)
print(f"Active Run Directory: {RUN_DIR.resolve()}")
print(f"Models Directory:     {MODELS_DIR.resolve()}")

# %% [markdown]
# ## 4. Configuration & Dataset Split Verification

# %%
import json
import numpy as np
import pandas as pd
from driftsense.runtime.config import load_config
from driftsense.data.clean import clean_focus_data
from driftsense.data.aggregate import aggregate_to_canonical_grain
from driftsense.data.acquire import acquire_dataset
from driftsense.eval.splits import chronological_split
from driftsense.features.builder import FeaturePipeline
from driftsense.forecast.xgb import XGBoostForecaster

CONFIG_PATH = "configs/detect_focus.yaml"
cfg, config_sha256 = load_config(CONFIG_PATH)

dataset_cfg = cfg.get("dataset", {})
synth_cfg = cfg.get("synthetic", {})
det_cfg = cfg.get("detectors", {})
eval_cfg = cfg.get("evaluation", {})

train_path = Path(dataset_cfg.get("train_path", "data/splits/train_features.csv"))
val_path = Path(dataset_cfg.get("val_path", "data/splits/val_features.csv"))

# Verify or regenerate splits if running in a fresh workspace
if not train_path.is_file() or not val_path.is_file():
    print("Feature splits not detected locally. Regenerating from pipeline...")
    raw_path = Path("data/raw/focus_sample_10000.csv")
    if not raw_path.is_file():
        d_cfg, _ = load_config("configs/data_focus.yaml")
        acquire_dataset(
            url=d_cfg["dataset"]["url"],
            destination=str(raw_path),
            expected_sha256=d_cfg["dataset"]["sha256"],
            overwrite=False,
        )
    df_raw = pd.read_csv(raw_path, low_memory=False)
    df_clean, _ = clean_focus_data(df_raw)
    df_agg, _ = aggregate_to_canonical_grain(df_clean, grain="1h")
    
    train_df, val_df, test_df, _ = chronological_split(df_agg, time_col="ChargePeriodStart")
    pipeline = FeaturePipeline()
    pipeline.fit(train_df)
    train_feats = pipeline.transform(train_df)
    val_feats = pipeline.transform(val_df)
    test_feats = pipeline.transform(test_df)
    
    train_path.parent.mkdir(parents=True, exist_ok=True)
    train_feats.to_csv(train_path, index=False)
    val_feats.to_csv(val_path, index=False)
    test_feats.to_csv(train_path.parent / "test_features.csv", index=False)

# Load training and validation partitions
df_train = pd.read_csv(train_path, low_memory=False)
df_val = pd.read_csv(val_path, low_memory=False)

# Strict A7.3 Isolation Guard
assert "test" not in str(val_path).lower(), "A7.3 VIOLATION: Test split passed into validation evaluator!"
print(f"Loaded Train Partition: {len(df_train):,} rows ({df_train['ServiceName'].nunique()} services)")
print(f"Loaded Val Partition:   {len(df_val):,} rows ({df_val['ServiceName'].nunique()} services)")

target_col = dataset_cfg.get("target_col", "EffectiveCost")
time_col = dataset_cfg.get("time_col", "ChargePeriodStart")
service_col = dataset_cfg.get("service_col", "ServiceName")
primary_metric = eval_cfg.get("primary_metric", "event_f1")

# %% [markdown]
# ## 5. Residual Calculation & Synthetic Ground-Truth Generation

# %%
from driftsense.synth.injector import SyntheticInjector

# Obtain champion forecast model or train quick XGBoost regressor if standalone
forecast_model_path = Path(dataset_cfg.get("forecast_model_path", ""))
if forecast_model_path.is_file():
    print(f"Loading champion forecaster from: {forecast_model_path}")
    forecaster = XGBoostForecaster.load(forecast_model_path)
else:
    print("Training champion XGBoost forecaster for residual baseline...")
    forecaster = XGBoostForecaster(n_estimators=100, max_depth=5, seed=42)
    forecaster.fit(df_train, target_col=target_col, time_col=time_col, service_col=service_col)

# Generate baseline point predictions
train_preds = forecaster.predict(df_train)
val_preds = forecaster.predict(df_val)

df_train["residual"] = df_train[target_col] - train_preds
df_val["residual"] = df_val[target_col] - val_preds

# Generate Calibrated Synthetic Ground Truth on D_val (Contract 5 & 6)
print("Injecting calibrated operational anomalies into validation series...")
injector = SyntheticInjector(
    seed=synth_cfg.get("seed", 42),
    injection_rate=synth_cfg.get("injection_rate", 0.03),
    min_duration_hours=synth_cfg.get("min_duration_hours", 2),
    max_duration_hours=synth_cfg.get("max_duration_hours", 6),
    multiplier_range=tuple(synth_cfg.get("multiplier_range", [1.5, 3.5])),
    sigma_range=tuple(synth_cfg.get("sigma_range", [2.5, 5.0])),
)
df_val_synth, labels, events = injector.inject(
    df_val,
    cost_col=target_col,
    service_col=service_col,
    time_col=time_col,
)
df_val_synth["residual"] = df_val_synth[target_col] - val_preds

# Save ground-truth Contract 5 & 6 tables
labels_path = RUN_DIR / "val_anomaly_labels.json"
events_path = RUN_DIR / "val_operational_events.json"
with open(labels_path, "w", encoding="utf-8") as f:
    json.dump(labels, f, indent=2)
with open(events_path, "w", encoding="utf-8") as f:
    json.dump(events, f, indent=2)

print(f"Generated {len(labels)} ground-truth anomaly events ({df_val_synth['is_anomaly'].sum()} total anomalous hours).")
print(f"Generated {len(events)} operational events (including benign decoy deployments).")

# %% [markdown]
# ## 6. Detector Training & Dual-Track Validation Benchmarking

# %%
from driftsense.detect.zscore import ZScoreDetector
from driftsense.detect.rolling_threshold import RollingThresholdDetector
from driftsense.detect.iforest import IsolationForestDetector
from driftsense.detect.ocsvm import OneClassSVMDetector
from driftsense.eval.detection_metrics import (
    point_level_metrics,
    event_level_metrics,
    stratified_fp_analysis,
)

detectors = [
    ZScoreDetector(
        threshold=det_cfg.get("zscore", {}).get("threshold", 3.0),
        per_service=det_cfg.get("zscore", {}).get("per_service", True),
        one_sided=det_cfg.get("zscore", {}).get("one_sided", True),
        config=det_cfg.get("zscore", {}),
    ),
    RollingThresholdDetector(
        window=det_cfg.get("rolling_threshold", {}).get("window", 24),
        threshold=det_cfg.get("rolling_threshold", {}).get("threshold", 3.0),
        config=det_cfg.get("rolling_threshold", {}),
    ),
    IsolationForestDetector(
        n_estimators=det_cfg.get("iforest", {}).get("n_estimators", 100),
        contamination=det_cfg.get("iforest", {}).get("contamination", 0.03),
        threshold=det_cfg.get("iforest", {}).get("threshold", 0.55),
        seed=det_cfg.get("iforest", {}).get("seed", 42),
        config=det_cfg.get("iforest", {}),
    ),
    OneClassSVMDetector(
        kernel=det_cfg.get("ocsvm", {}).get("kernel", "rbf"),
        nu=det_cfg.get("ocsvm", {}).get("nu", 0.03),
        threshold=det_cfg.get("ocsvm", {}).get("threshold", 0.0),
        config=det_cfg.get("ocsvm", {}),
    ),
]

saved_checkpoints = []
results_real = {}
results_synthetic = {}

detections_dict = {
    time_col: df_val[time_col],
    service_col: df_val[service_col],
    "is_synthetic_anomaly": df_val_synth["is_anomaly"],
    "cost_actual_clean": df_val[target_col],
    "cost_actual_synth": df_val_synth[target_col],
    "residual_clean": df_val["residual"],
    "residual_synth": df_val_synth["residual"],
}

print("=== Fitting Detectors on D_train Residuals ===")
for i, det in enumerate(detectors, 1):
    print(f"\n[{i}/{len(detectors)}] Fitting {det.name}...")
    det.fit(
        df_train,
        residual_col="residual",
        service_col=service_col,
        time_col=time_col,
    )

    # 1. Real Data Track
    clean_scores = det.score(df_val)
    clean_preds = det.predict(df_val)
    detections_dict[f"score_clean_{det.name}"] = clean_scores
    detections_dict[f"alert_clean_{det.name}"] = clean_preds

    y_zero = np.zeros(len(df_val), dtype=int)
    df_val_eval = df_val.copy()
    df_val_eval["y_zero"] = y_zero
    df_val_eval["pred"] = clean_preds
    fp_strat = stratified_fp_analysis(df_val_eval, y_true_col="y_zero", y_pred_col="pred")
    results_real[det.name] = {
        "total_points": len(df_val),
        "false_positives": int(np.sum(clean_preds == 1)),
        "fpr": float(np.mean(clean_preds == 1)),
        "stratified_fpr": fp_strat,
        "metadata": det.get_metadata(),
    }

    # 2. Synthetic Track
    synth_scores = det.score(df_val_synth)
    synth_preds = det.predict(df_val_synth)
    detections_dict[f"score_synth_{det.name}"] = synth_scores
    detections_dict[f"alert_synth_{det.name}"] = synth_preds

    p_metrics = point_level_metrics(
        y_true=df_val_synth["is_anomaly"].to_numpy(dtype=int),
        y_pred=synth_preds,
    )
    ev_metrics = event_level_metrics(
        timestamps=df_val_synth[time_col],
        y_true=df_val_synth["is_anomaly"].to_numpy(dtype=int),
        y_pred=synth_preds,
    )
    results_synthetic[det.name] = {
        "point_metrics": p_metrics,
        "event_metrics": ev_metrics,
        "metadata": det.get_metadata(),
    }

    chk = det.save(MODELS_DIR)
    saved_checkpoints.append(str(chk))
    print(f"    Checkpointed: {chk.name}")

# Print Track 1 Table
print("\n" + "=" * 90)
print("TRACK 1: REAL DATA TRACK (False Positive Rate & Diurnal Stratification)")
print("=" * 90)
h_real = f"{'Detector':<22} | {'Alerts':<8} | {'Overall FPR (%)':<15} | {'Weekday FPR (%)':<15} | {'Weekend FPR (%)':<15}"
print(h_real)
print("-" * len(h_real))
for name, res in results_real.items():
    st = res.get("stratified_fpr", {})
    wk_fpr = st.get("weekday_fpr", 0.0) * 100.0
    we_fpr = st.get("weekend_fpr", 0.0) * 100.0
    print(
        f"{name:<22} | {res['false_positives']:<8} | {res['fpr']*100:<15.2f} | {wk_fpr:<15.2f} | {we_fpr:<15.2f}"
    )

# Print Track 2 Table
print("\n" + "=" * 90)
print("TRACK 2: SYNTHETIC GROUND-TRUTH TRACK (Calibrated Incident Evaluation)")
print("=" * 90)
h_synth = f"{'Detector':<22} | {'Point F1':<10} | {'Point Prec':<10} | {'Point Rec':<10} | {'Event F1':<10} | {'Event Rec':<10} | {'Mean Delay (h)':<14}"
print(h_synth)
print("-" * len(h_synth))
for name, res in results_synthetic.items():
    pm = res["point_metrics"]
    em = res["event_metrics"]
    print(
        f"{name:<22} | {pm['f1']:<10.4f} | {pm['precision']:<10.4f} | {pm['recall']:<10.4f} | {em['event_f1']:<10.4f} | {em['event_recall']:<10.4f} | {em['mean_delay_hours']:<14.2f}"
    )

# Select Champion Detector
champion_name = max(
    results_synthetic.keys(),
    key=lambda k: results_synthetic[k]["event_metrics"].get(primary_metric, 0.0),
)
print("=" * 90)
print(f"CHAMPION DETECTOR SELECTED: '{champion_name}' (Highest {primary_metric.upper()} on Validation Ground Truth)")
print("=" * 90)

# Save validation metrics JSON
metrics_payload = {
    "run_id": RUN_ID,
    "timestamp_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "primary_metric": primary_metric,
    "champion_detector": champion_name,
    "validation_rows": len(df_val),
    "synthetic_incidents": len(labels),
    "real_track": results_real,
    "synthetic_track": results_synthetic,
}
val_metrics_path = RUN_DIR / "val_detect_metrics.json"
with open(val_metrics_path, "w", encoding="utf-8") as f:
    json.dump(metrics_payload, f, indent=2)
print(f"\nSaved validation detection metrics to: {val_metrics_path}")

# Save validation detections CSV
val_detections_df = pd.DataFrame(detections_dict)
val_detections_path = RUN_DIR / "val_detections.csv"
val_detections_df.to_csv(val_detections_path, index=False)
print(f"Saved validation detections matrix to:  {val_detections_path}")

# %% [markdown]
# ## 7. Detection Visualizations

# %%
import matplotlib.pyplot as plt

top_services = (
    df_val_synth.groupby(service_col)[target_col]
    .sum()
    .sort_values(ascending=False)
    .head(3)
    .index.tolist()
)

fig, axes = plt.subplots(len(top_services), 1, figsize=(15, 4.5 * len(top_services)), sharex=False)
if len(top_services) == 1:
    axes = [axes]

for ax, svc in zip(axes, top_services):
    mask = df_val_synth[service_col] == svc
    svc_data = df_val_synth[mask].sort_values(by=time_col)
    t = pd.to_datetime(svc_data[time_col], utc=True)
    
    # Plot cost and residuals
    ax.plot(t, svc_data[target_col], label="Observed Cost ($)", color="black", linewidth=1.5, alpha=0.8)
    ax.plot(t, svc_data["residual"], label="Residual e(t)", color="steelblue", linestyle="--", linewidth=1.2)
    
    # Ground truth anomalies
    anom_points = svc_data[svc_data["is_anomaly"] == 1]
    if not anom_points.empty:
        t_anom = pd.to_datetime(anom_points[time_col], utc=True)
        ax.scatter(t_anom, anom_points[target_col], color="crimson", marker="x", s=60, label="True Anomaly Window", zorder=5)

    # Champion detector alerts
    alert_col = f"alert_synth_{champion_name}"
    if alert_col in val_detections_df.columns:
        svc_alerts = val_detections_df.loc[mask].sort_values(by=time_col)
        triggered = svc_alerts[svc_alerts[alert_col] == 1]
        if not triggered.empty:
            t_trig = pd.to_datetime(triggered[time_col], utc=True)
            ax.scatter(t_trig, triggered["cost_actual_synth"], color="orange", marker="o", facecolors="none", s=100, linewidth=1.8, label=f"Alert: {champion_name}", zorder=6)

    ax.set_title(f"Validation Incident Timeline: {svc}", fontsize=12, fontweight="bold")
    ax.set_ylabel("Cost / Residual ($)")
    ax.grid(True, alpha=0.3)
    ax.legend(loc="upper right", framealpha=0.9)

plt.tight_layout()
plot_path = RUN_DIR / "detection_comparison.png"
fig.savefig(plot_path, dpi=200, bbox_inches="tight")
plt.close(fig)
print(f"Saved detection timeline plot to: {plot_path}")

# %% [markdown]
# ## 8. Run Manifest Compilation & Anti-Leakage Audit

# %%
from driftsense.runtime.manifest import ManifestBuilder, verify_manifest
from driftsense.runtime.seed import set_seed

set_seed(cfg.get("runtime", {}).get("seed", 42))

builder = ManifestBuilder(
    run_id=RUN_ID,
    phase="PHASE_7",
    stage="anomaly_detection",
    config_path=CONFIG_PATH,
    seed=cfg.get("runtime", {}).get("seed", 42),
)

builder.add_dataset(str(train_path))
builder.add_dataset(str(val_path))

for chk in saved_checkpoints:
    builder.add_artifact(chk)
builder.add_artifact(str(val_metrics_path))
builder.add_artifact(str(val_detections_path))
builder.add_artifact(str(labels_path))
builder.add_artifact(str(events_path))
builder.add_artifact(str(plot_path))

manifest_path = builder.save(RUN_DIR)
print(f"\nManifest successfully emitted to: {manifest_path}")

# Strict A7.3 Anti-Leakage Audit
manifest_data = json.loads(manifest_path.read_text(encoding="utf-8"))
for art in manifest_data.get("artifacts", []):
    path_str = art.get("path", "").lower()
    assert "test_features" not in path_str, f"A7.3 LEAKAGE: Test split found in manifest: {path_str}"
    assert "test_detect" not in path_str, f"A7.3 LEAKAGE: Test detections found in manifest: {path_str}"

print("PASS: A7.3 Anti-Leakage Invariant Verified (Zero test artifacts in manifest).")

is_valid, errors = verify_manifest(RUN_DIR, require_datasets=True)
if is_valid:
    print("PASS: Run manifest verification succeeded (All SHA256 checksums verified).")
else:
    print(f"FAIL: Manifest verification failed: {errors}")
    sys.exit(1)

