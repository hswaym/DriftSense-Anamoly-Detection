# %% [markdown]
# ## 2. Cryptographic Hash Guard Verification (A13.1)
#
# Enforces that all 8 configuration files match their frozen SHA-256 digests in `docs/final_results_protocol.md`.

# %%
from driftsense.eval.final import FROZEN_CONFIG_HASHES, assert_config_hashes_frozen, verify_config_hashes

print("=== Enforcing A13.1 Cryptographic Hash Guard ===")
is_valid, errors = verify_config_hashes()
if not is_valid:
    print("FAIL: Hash guard violation! Config files have been modified from frozen protocol:")
    for err in errors:
        print(f"  - {err}")
    raise RuntimeError("A13.1 Violation: Cannot evaluate test set with modified configurations.")
else:
    print("PASS: A13.1 Hash Guard Verified. All 8 configuration digests match frozen protocol byte-for-byte:")
    for rel_path, expected_hash in FROZEN_CONFIG_HASHES.items():
        print(f"  [OK] {rel_path:<30} -> {expected_hash[:16]}...")

# %% [markdown]
# ## 3. Ingestion of Training ($D_{\text{train}}$) and Unseen Test ($D_{\text{test}}$) Splits
#
# - $D_{\text{train}}$: Days 1–15 (historical baselines)
# - $D_{\text{test}}$: Days 25–30 (unseen future horizon)

# %%
import pandas as pd
from datetime import datetime, timezone
from pathlib import Path
from driftsense.runtime.config import load_config
from driftsense.data.acquire import acquire_dataset
from driftsense.data.clean import clean_focus_data
from driftsense.data.aggregate import aggregate_to_canonical_grain
from driftsense.eval.splits import chronological_split
from driftsense.features.builder import FeaturePipeline

train_path = Path("data/splits/train_features.csv")
test_path = Path("data/splits/test_features.csv")

if not train_path.is_file() or not test_path.is_file():
    print("Splits not found locally. Running self-contained acquisition and feature pipeline...")
    raw_path = Path("data/raw/focus_sample_10000.csv")
    if not raw_path.is_file():
        raw_path.parent.mkdir(parents=True, exist_ok=True)
        d_cfg, _ = load_config("configs/data_focus.yaml")
        print("Acquiring raw dataset...")
        acquire_dataset(
            url=d_cfg["dataset"]["url"],
            destination=str(raw_path),
            expected_sha256=d_cfg["dataset"]["sha256"],
            overwrite=False,
        )
    print("Cleaning and aggregating dataset to 1h canonical grain...")
    df_raw = pd.read_csv(raw_path, low_memory=False)
    df_clean, _ = clean_focus_data(df_raw)
    df_agg, _ = aggregate_to_canonical_grain(df_clean, grain="1h")

    print("Splitting chronologically (train/val/test)...")
    train_df, val_df, test_df, _ = chronological_split(df_agg, time_col="ChargePeriodStart")

    print("Fitting FeaturePipeline on train split and transforming all partitions...")
    pipeline = FeaturePipeline()
    pipeline.fit(train_df)
    train_feats = pipeline.transform(train_df)
    val_feats = pipeline.transform(val_df)
    test_feats = pipeline.transform(test_df)

    train_path.parent.mkdir(parents=True, exist_ok=True)
    train_feats.to_csv(train_path, index=False)
    val_feats.to_csv(train_path.parent / "val_features.csv", index=False)
    test_feats.to_csv(test_path, index=False)
    print("Feature splits written successfully to data/splits/.")

df_train = pd.read_csv(train_path, low_memory=False)
df_test = pd.read_csv(test_path, low_memory=False)

print("=== Partition Summary ===")
print(f"Train Slice (D_train): {len(df_train):,} rows ({df_train['ChargePeriodStart'].min()} -> {df_train['ChargePeriodStart'].max()})")
print(f"Test Slice  (D_test):  {len(df_test):,} rows ({df_test['ChargePeriodStart'].min()} -> {df_test['ChargePeriodStart'].max()})")

# Initialize Run Directory
run_id = f"run_{datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S')}_{os.urandom(3).hex()}"
run_dir = Path(f"runs/{run_id}")
run_dir.mkdir(parents=True, exist_ok=True)
print(f"Allocated Phase 13 Run Directory: {run_dir}")

# %% [markdown]
# ## 4. Execution of Final Locked Evaluation Pipeline
#
# Evaluates:
# 1. Expected Cost Forecaster (Champion XGBoost vs Baselines across 3 seeds)
# 2. Anomaly Detection (Clean Track FPR vs Synthetic Track Event-F1)
# 3. Root-Cause Attribution (Temporal Correlation vs Baselines)
# 4. TreeSHAP Explainability (Additivity verification & Audit Narratives)

# %%
from driftsense.eval.final import evaluate_final_test_set

final_results = evaluate_final_test_set(
    df_train=df_train,
    df_test=df_test,
    output_dir=run_dir,
    target_col="EffectiveCost",
    service_col="ServiceName",
    time_col="ChargePeriodStart",
    usage_col="ConsumedQuantity",
    seeds=[42, 123, 999],
    atol_shap=0.002,
    allow_override=True,  # Permit initial evaluation in newly allocated run_dir
    verify_hashes=True,
)
print("Locked test set evaluation finished successfully.")

