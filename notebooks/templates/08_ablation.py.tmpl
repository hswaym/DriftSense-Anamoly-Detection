# %% [markdown]
# ## 9. Cryptographic Manifest Builder & Verification

# %%
from driftsense.runtime.manifest import ManifestBuilder, verify_manifest
from driftsense.runtime.seed import set_seed

set_seed(42)

# Save metrics JSON
metrics_path = RUN_DIR / "ablation_metrics.json"
with open(metrics_path, "w", encoding="utf-8") as f:
    json.dump(ablation_results, f, indent=2, default=str)
print(f"Saved full ablation metrics to: {metrics_path}")

builder = ManifestBuilder(
    run_id=RUN_ID,
    phase="PHASE_10",
    stage="controlled_experiments",
    config_path=CONFIG_PATH,
    config_sha256=config_sha256,
    seed=42,
)

builder.add_dataset(str(train_path))
builder.add_dataset(str(val_path))

builder.add_artifact(str(summary_csv_path))
builder.add_artifact(str(metrics_path))
builder.add_artifact(str(notes_path))
builder.add_artifact(str(chart_path))

manifest_path = builder.save(RUN_DIR)
print(f"\nManifest successfully emitted to: {manifest_path}")

# Strict A10.1 Anti-Leakage Audit
manifest_data = json.loads(manifest_path.read_text(encoding="utf-8"))
for art in manifest_data.get("artifacts", []):
    path_str = art.get("path", "").lower()
    assert "test_features" not in path_str, f"A10.1 LEAKAGE: Test split found in manifest: {path_str}"
    assert "test_ablation" not in path_str, f"A10.1 LEAKAGE: Test ablation found in manifest: {path_str}"

print("PASS: A10.1 Anti-Leakage Invariant Verified (Zero test artifacts in manifest).")

is_valid, errors = verify_manifest(RUN_DIR, require_datasets=True)
if is_valid:
    print("PASS: Run manifest verification succeeded (All SHA256 checksums verified).")
else:
    print(f"FAIL: Manifest verification failed: {errors}")
    sys.exit(1)

