# %% [markdown]
# ## 3. Storage Setup & Run Directory Initialization

# %%
import uuid
import datetime

RUN_ID = f"run_{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:6]}"
RUN_DIR = Path(f"runs/{RUN_ID}")
RUN_DIR.mkdir(parents=True, exist_ok=True)
print(f"Active Run Directory: {RUN_DIR.resolve()}")

# %% [markdown]
# ## 4. Protocol Verification & Split Anti-Leakage Audit

# %%
import json
import numpy as np
import pandas as pd
from driftsense.runtime.config import load_config
from driftsense.eval.ablation import (
    AblationRunner,
    validate_splits_invariants,
    validate_split_paths,
    hash_file_sha256,
    SYNTHETIC_EVENT_CIRCULARITY_CAVEAT,
)

CONFIG_PATH = "configs/ablation_focus.yaml"
cfg, config_sha256 = load_config(CONFIG_PATH)

protocol_path = cfg.get("protocol", {}).get("path", "docs/experiment_protocol.md")
expected_protocol_hash = cfg.get("protocol", {}).get("sha256", "")
actual_protocol_hash = hash_file_sha256(protocol_path)

print(f"Experiment Protocol Path:   {protocol_path}")
print(f"Expected Protocol SHA256:   {expected_protocol_hash}")
print(f"Actual Protocol SHA256:     {actual_protocol_hash}")
assert actual_protocol_hash == expected_protocol_hash, "PROTOCOL DRIFT: Protocol hash mismatch!"
print("PASS: Experiment Protocol Verified and Unmodified.")

# Load splits
ds_cfg = cfg.get("dataset", {})
train_path = Path(ds_cfg.get("train_path", "data/splits/train_features.csv"))
val_path = Path(ds_cfg.get("val_path", "data/splits/val_features.csv"))

# Verify A10.1 strict test split isolation
validate_split_paths(train_path, val_path)

print(f"\nLoading training features:   {train_path}")
df_train = pd.read_csv(train_path, low_memory=False)
print(f"Loading validation features: {val_path}")
df_val = pd.read_csv(val_path, low_memory=False)

time_col = ds_cfg.get("time_col", "ChargePeriodStart")
target_col = ds_cfg.get("target_col", "EffectiveCost")
service_col = ds_cfg.get("service_col", "ServiceName")

# Strict Invariant Check
split_info = validate_splits_invariants(df_train, df_val, time_col=time_col)
print(f"PASS: A10.1 Chronological Split Invariants Verified.")
print(f"Train Period: {split_info['train_start']} to {split_info['train_end']} ({split_info['train_rows']:,} rows)")
print(f"Val Period:   {split_info['val_start']} to {split_info['val_end']} ({split_info['val_rows']:,} rows)")

# Load events and incidents for attribution ablation (Arm 5)
events_path = Path(ds_cfg.get("val_events_path", ""))
labels_path = Path(ds_cfg.get("val_labels_path", ""))
events = []
incidents = []
if events_path.is_file():
    with open(events_path, "r", encoding="utf-8") as f:
        events = json.load(f)
if labels_path.is_file():
    with open(labels_path, "r", encoding="utf-8") as f:
        incidents = json.load(f)

print(f"Loaded {len(events)} operational events and {len(incidents)} validation incidents.")

# %% [markdown]
# ## 5. Execute 7 Controlled Experimental Arms

# %%
runner = AblationRunner(config=cfg, protocol_path=protocol_path)

print("\n" + "=" * 80)
print("EXECUTING PHASE 10 ABLATION SUITE (7 CONTROLLED ARMS ACROSS 3 RANDOM SEEDS)")
print("=" * 80)

ablation_results = runner.run_all(df_train, df_val, incidents=incidents, events=events)

arms = ablation_results["arms"]
print("\n=== All 7 Arms Executed Successfully ===")

# %% [markdown]
# ## 6. Results Analysis & Summary Tables

# %%
summary_df = pd.DataFrame(ablation_results["summary_records"])
summary_csv_path = RUN_DIR / "ablation_summary.csv"
summary_df.to_csv(summary_csv_path, index=False)
print(f"Saved summary table to: {summary_csv_path}\n")

print("=" * 95)
print(f"{'ARM / CONFIGURATION':<40} | {'MEAN WAPE':<10} | {'STD WAPE':<10} | {'MEAN MASE':<10} | {'STD MASE':<10}")
print("=" * 95)
for _, r in summary_df.iterrows():
    wape_str = f"{r['Mean_WAPE']:.2f}%" if pd.notna(r['Mean_WAPE']) else "N/A"
    std_w_str = f"±{r['Std_WAPE']:.2f}%" if pd.notna(r['Std_WAPE']) else "N/A"
    mase_str = f"{r['Mean_MASE']:.4f}" if pd.notna(r['Mean_MASE']) else "N/A"
    std_m_str = f"±{r['Std_MASE']:.4f}" if pd.notna(r['Std_MASE']) else "N/A"
    print(f"{r['Arm']:<40} | {wape_str:<10} | {std_w_str:<10} | {mase_str:<10} | {std_m_str:<10}")
print("=" * 95)

# Detailed Printout for Arm 4, 5, 6, 7
print("\n--- Arm 4: Baseline vs Advanced Architecture ---")
arm4 = arms["arm_4"]
fc4 = arm4["forecasting"]
print(f"Seasonal Naive WAPE:       {fc4['seasonal_naive']['wape']:.2f}% (MASE: {fc4['seasonal_naive']['mase']:.4f})")
print(f"Moving Average WAPE:       {fc4['moving_average']['wape']:.2f}% (MASE: {fc4['moving_average']['mase']:.4f})")
print(f"Exponential Smoothing WAPE: {fc4['exponential_smoothing']['wape']:.2f}% (MASE: {fc4['exponential_smoothing']['mase']:.4f})")
print(f"Champion XGBoost WAPE:     {fc4['xgboost_champion']['mean_wape']:.2f}% ± {fc4['xgboost_champion']['std_wape']:.2f}% (MASE: {fc4['xgboost_champion']['mean_mase']:.4f})")
print(f"WAPE Reduction over Naive: {fc4['wape_reduction_vs_naive_pct']:.1f}%")
print(f"Baseline Z-Score FPR:      {arm4['detection']['baseline_zscore_fpr'] * 100:.2f}%")
print(f"Rolling Threshold FPR:     {arm4['detection']['champion_rolling_threshold_fpr'] * 100:.2f}%")

print("\n--- Arm 5: Attribution With vs Without Event Telemetry ---")
arm5 = arms["arm_5"]
if arm5.get("total_incidents", 0) > 0:
    uninf = arm5["uninformed_without_events"]
    inf = arm5["informed_with_events"]
    print(f"Random Uniform Top-1:      {uninf['random_uniform']['mean_top1'] * 100:.1f}% (Top-3: {uninf['random_uniform']['mean_top3'] * 100:.1f}%)")
    print(f"Service Prior Top-1:       {uninf['service_prior']['top1'] * 100:.1f}% (Top-3: {uninf['service_prior']['top3'] * 100:.1f}%)")
    print(f"Temporal Correlation Top-1:{inf['temporal_correlation_champion']['top1'] * 100:.1f}% (Top-3: {inf['temporal_correlation_champion']['top3'] * 100:.1f}%)")
    print(f"XGBoost Attributor Top-1:  {inf['xgboost_attributor']['mean_top1'] * 100:.1f}% (Top-3: {inf['xgboost_attributor']['mean_top3'] * 100:.1f}%)")

print("\n--- Arm 6: Temporal Generalization (Horizon Drift) ---")
arm6 = arms["arm_6"]
print(f"Early Val Window (Days 16-20) WAPE: {arm6['early_val_window']['mean_wape']:.2f}% ± {arm6['early_val_window']['std_wape']:.2f}%")
print(f"Late Val Window (Days 20-24) WAPE:  {arm6['late_val_window']['mean_wape']:.2f}% ± {arm6['late_val_window']['std_wape']:.2f}%")
print(f"Forward Horizon WAPE Drift:         {arm6['wape_horizon_drift']:+.2f}%")

print("\n--- Arm 7: Seasonality & Workload-Change FP Robustness ---")
arm7 = arms["arm_7"]
print(f"Overall Clean FPR:                  {arm7['overall_clean_fpr'] * 100:.2f}% ({arm7['overall_false_positives']} FPs)")
print(f"Peak Business Hours FPR:            {arm7['regimes']['peak_business_hours']['fpr'] * 100:.2f}%")
print(f"Off-Peak / Weekend Hours FPR:       {arm7['regimes']['off_peak_and_weekend']['fpr'] * 100:.2f}%")
print(f"Robustness Criteria (FPR <= 1.0%):  {'PASS' if arm7['robustness_pass'] else 'FAIL'}")

# %% [markdown]
# ## 7. Ablation Visualization Charts

# %%
import matplotlib.pyplot as plt

plt.style.use("seaborn-v0_8-whitegrid" if "seaborn-v0_8-whitegrid" in plt.style.available else "default")
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

# Subplot 1: Feature Representation & Forecaster Ablation
forecaster_arms = [
    "Arm 1: Cost-Only",
    "Arm 2: Cost + Usage",
    "Arm 3: Cost+Usage+Events",
    "Arm 4: Champion XGB",
    "Arm 4: Seasonal Naive",
]
wapes = [
    arms["arm_1"]["mean_wape"],
    arms["arm_2"]["mean_wape"],
    arms["arm_3"]["mean_wape"],
    fc4["xgboost_champion"]["mean_wape"],
    fc4["seasonal_naive"]["wape"],
]
errs = [
    arms["arm_1"]["std_wape"],
    arms["arm_2"]["std_wape"],
    arms["arm_3"]["std_wape"],
    fc4["xgboost_champion"]["std_wape"],
    0.0,
]
colors = ["#4A90E2", "#50E3C2", "#B8E986", "#F5A623", "#D0021B"]

bars = axes[0].bar(range(len(forecaster_arms)), wapes, yerr=errs, capsize=5, color=colors, alpha=0.85, edgecolor="black")
axes[0].set_xticks(range(len(forecaster_arms)))
axes[0].set_xticklabels(forecaster_arms, rotation=25, ha="right", fontsize=10)
axes[0].set_ylabel("Validation WAPE (%)", fontsize=11, fontweight="bold")
axes[0].set_title("Feature & Architecture Ablation (Lower is Better)", fontsize=13, fontweight="bold")
for bar, val in zip(bars, wapes):
    axes[0].text(bar.get_x() + bar.get_width() / 2, val + 1.5, f"{val:.1f}%", ha="center", va="bottom", fontsize=10, fontweight="bold")

# Subplot 2: Temporal Horizon Generalization & Regime Robustness
regimes = ["Early Val (Days 16-20)", "Late Val (Days 20-24)", "Peak Hours FPR", "Off-Peak FPR"]
vals = [
    arm6["early_val_window"]["mean_wape"],
    arm6["late_val_window"]["mean_wape"],
    arm7["regimes"]["peak_business_hours"]["fpr"] * 100,
    arm7["regimes"]["off_peak_and_weekend"]["fpr"] * 100,
]
bar2 = axes[1].bar(regimes[:2], vals[:2], color="#4A90E2", alpha=0.8, edgecolor="black", label="WAPE (%)")
axes[1].set_ylabel("WAPE (%)", color="#1B365D", fontsize=11, fontweight="bold")
axes[1].set_title("Temporal Generalization (Days 16-20 vs 20-24)", fontsize=13, fontweight="bold")
for b, v in zip(bar2, vals[:2]):
    axes[1].text(b.get_x() + b.get_width() / 2, v + 1.0, f"{v:.1f}%", ha="center", va="bottom", fontsize=10, fontweight="bold")

plt.tight_layout()
chart_path = RUN_DIR / "ablation_comparison.png"
plt.savefig(chart_path, dpi=300, bbox_inches="tight")
plt.close()
print(f"Saved ablation comparison chart to: {chart_path}")

